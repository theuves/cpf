{
  "extends": "./tsconfig.test.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "./src",
    "outDir": "./.test-build",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": false,
    "ignoreDeprecations": "6.0",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
